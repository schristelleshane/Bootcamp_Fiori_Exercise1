<mvc:View xmlns:mvc="sap.ui.core.mvc" 
    xmlns="sap.m" 
    xmlns:sap.ui.layout.form="sap.ui.layout.form" 
    xmlns:sap.ui.core="sap.ui.core" 
    controllerName="com.acn.training.fioriexercise1.controller.simpleForm" >
    <Page id="page" title="{i18n>title}">
        <content>
            <GroupHeaderListItem id="item1"/><sap.ui.layout.form:SimpleForm editable="true" layout="ResponsiveGridLayout" id="form0" labelSpanL="2" columnsM="7">
                <sap.ui.layout.form:content>
                    <sap.ui.core:Title text="SAP UI5 Exercise 1" id="title_exercise"/>

                    <!--Name-->
                    <Label text="Name" id="lbl_name"/>
                    <Input width="100%" id="zfld_name" placeholder="Last Name, First Name Middle Name"/>

                    <!--Street/No.-->
                    <Label text="Street/No." id="lbl_street"/>
                    <Input width="100%" id="zfld_street" placeholder="Street"/>
                    <Input width="100%" id="zfld_stnum" type="Number" placeholder="Street No."/>

                    <!--ZIP Code/City-->
                    <Label text="ZIP Code/City" id="lbl_zipcty"/>
                    <Input width="100%" id="zfld_zipcode" type="Number" placeholder="ZIP Code"/>
                    <Input width="100%" id="zfld_city" placeholder="City"/>
                    
                    <!--Country-->
                    <Label text="Country" id="lbl_country"/>
                    <Select id="sel_country">
                        <items>
                            <core:Item xmlns:core="sap.ui.core" key="UK" text="England" id="cb_uk"/>
                            <core:Item xmlns:core="sap.ui.core" key="DE" text="Germany" id="cb_de"/>
                            <core:Item xmlns:core="sap.ui.core" key="US" text="USA" id="cb_us"/>
                            <core:Item xmlns:core="sap.ui.core" key="PH" text="Philippines" id="cb_ph"/>
                        </items>                    
                    </Select>
                    <!--<ComboBox id="cb_cntry" placeholder="Country">
                        <items>
                            <core:Item xmlns:core="sap.ui.core" key="UK" text="England" id="cb_uk"/>
                            <core:Item xmlns:core="sap.ui.core" key="DE" text="Germany" id="cb_de"/>
                            <core:Item xmlns:core="sap.ui.core" key="US" text="USA" id="cb_us"/>
                            <core:Item xmlns:core="sap.ui.core" key="PH" text="Philippines" id="cb_ph"/>
                        </items>                    
                    </ComboBox>-->               
                </sap.ui.layout.form:content>
            </sap.ui.layout.form:SimpleForm>

            <!--Buttons-->
            <Bar id="space_bar"/>
            <Bar id="bar_buttons">
                <contentRight>
                    <Button text="Save" id="btn_save" icon="sap-icon://save" type="Accept"/>    
                    <Button text="Clear" id="btn_clear" icon="sap-icon://delete" type="Reject" press="onClearClick"/>
                </contentRight>
            </Bar>
        </content>
    </Page>
</mvc:View>